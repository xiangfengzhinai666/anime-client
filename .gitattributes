# 统一换行符与文本判定，避免 Windows/Linux 混用时产生无意义 diff
* text=auto eol=lf

# Windows 脚本保持 CRLF
*.bat   text eol=crlf
*.cmd   text eol=crlf
*.ps1   text eol=crlf

# 二进制
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.webp  binary
*.ico   binary
*.ttf   binary
*.otf   binary
*.woff  binary
*.woff2 binary
*.zip   binary
*.exe   binary
*.dll   binary
*.lib   binary
*.so    binary
*.dylib binary
*.apk   binary
*.aab   binary
*.ipa   binary
*.dmg   binary
*.deb   binary
